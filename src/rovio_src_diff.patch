+    y_mat.at<float>(0, 0) = y(0);
+    y_mat.at<float>(0, 1) = y(1);
+    y_mat = y_mat.reshape(2); // Nx1, 2-channel
+
+
+    cv::Matx33d K(K_(0,0), 0, K_(0,2), 0, K_(1,1), K_(1,2), 0, 0, 1);
+    cv::Vec4d D(k1_, k2_, k3_, k4_);
