+  bool Camera::pixelToBearingAnalytical(const cv::Point2f& c,Eigen::Vector3d& vec) const{
+    // Shift origin and scale
+    Eigen::Vector2d y;
+    // y(0) = (static_cast<double>(c.x) - K_(0, 2)) / K_(0, 0);
